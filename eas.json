{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_OPENWEATHER_API_KEY": "https://weather.googleapis.com/v1/currentConditions:lookup"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}